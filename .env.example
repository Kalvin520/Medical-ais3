# Medical AIS3 portable Docker lab
#
# The lab has safe-to-share synthetic defaults, so this file is optional.
# To customize a local deployment:
#   cp .env.example .env
#
# Never reuse these intentionally weak lab credentials outside this isolated lab.

SEED_VERSION=2026.07.25-mvp
COMPOSE_PROJECT_NAME=medical-ais3
FHIR_HOST_PORT=8180

# Prebuilt multi-architecture images. The default "main" tag is published by
# GitHub Actions for linux/amd64 and linux/arm64.
IMAGE_REGISTRY=ghcr.io/kalvin520
IMAGE_PREFIX=medical-ais3
IMAGE_TAG=main

VENDOR_USER=vendor
VENDOR_PASS=Vendor@123
BIOMED_USER=biomed
BIOMED_PASS=Vendor@123

FHIR_TEST_TOKEN=lab-fhir-token-overprivileged
DICOMWEB_TEST_TOKEN=lab-dicomweb-token-overprivileged
FHIR_SCOPED_TOKEN=lab-fhir-token-patient001
DICOMWEB_SCOPED_TOKEN=lab-dicomweb-token-patient001

PACS_AE_TITLE=HOSP_PACS
MRI_AE_TITLE=HOSP_MRI
RIS_AE_TITLE=HOSP_RIS
